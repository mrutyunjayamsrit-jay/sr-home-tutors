# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sr_home_tutors?schema=public"

# --- Auth / JWT ---
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Google OIDC (Super Admin / Branch Admin sign-in) ---
# Create OAuth 2.0 credentials in Google Cloud Console. Restrict the
# redirect URI to APP_URL/api/auth/google/callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Cookies ---
COOKIE_SECRET=replace-with-another-long-random-secret
# true only when the web app is served from a DIFFERENT origin than this API
# (e.g. frontend on Cloudflare Pages, API on its own domain/VM) — required
# for the refresh-token cookie to survive a cross-site request at all.
# Leave false when the frontend is same-origin (proxied through/served by
# this API's own domain).
COOKIE_CROSS_SITE=false

# --- File storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# S3-compatible (used when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Email (invites, password resets, notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SR Home Tutors <no-reply@example.com>"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_MAX=10

# --- One-time bootstrap (used only by `npm run seed`) ---
# If omitted, the seed script generates and prints a random temp password.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# --- Demo/test accounts (used only by `npm run seed`) ---
# Creates admin@test.com / branch@test.com / tutor@test.com / parent@test.com
# / student@test.com, all sharing this password, so every role's UI can be
# reviewed without hand-creating data. Leave unset for a documented dev-only
# default (see src/config/env.ts). These are refused in production unless
# ALLOW_TEST_SEED=true — never turn that on against a real database.
TEST_USER_PASSWORD=
ALLOW_TEST_SEED=false
