# Reverse proxy + automatic HTTPS (Let's Encrypt) for the API on the Oracle
# VM. Caddy handles certificate issuance/renewal entirely on its own — no
# certbot, no manual cert management.
#
# Replace api.yourdomain.com with your real domain (an A/AAAA record
# pointing at the Oracle VM's public IP) before first run — Caddy needs a
# real domain to issue a certificate against; it won't do this for a bare
# IP address.

api.yourdomain.com {
	reverse_proxy api:4000

	encode gzip

	log {
		output stdout
		format console
	}
}
